# ── LLM swarm (optional) ───────────────────────────────────────────────
# Without a key AegisCode runs in static-only mode (engine + OSV + triage).
GEMINI_API_KEY=
# Any Gemini model that supports structured JSON output. The alias tracks the current Flash release.
GEMINI_MODEL=gemini-flash-latest

# ── GitHub (optional) ──────────────────────────────────────────────────
# Raises the API limit from 60 to 5,000 req/h and enables private repositories.
# A fine-grained token with read-only "Contents" + "Metadata" is enough.
GITHUB_TOKEN=

# ── Limits ─────────────────────────────────────────────────────────────
MAX_REPO_FILES=40
RATE_LIMIT_PER_10_MIN=12

# Used for absolute Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
